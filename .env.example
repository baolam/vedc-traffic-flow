# ==============================================================================
# EdgeFlow AI - Centralized Environment Configuration File (.env)
# All microservices read settings from this file using pydantic-settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Infrastructure Settings
# ------------------------------------------------------------------------------
EDGEFLOW_ENV=dev
EDGEFLOW_SCHEMA_VERSION=1.0
LOG_LEVEL=INFO

# MQTT Broker Configuration
MQTT_HOST=mqtt
MQTT_PORT=1883

# Optional custom directory path for contracts JSON schemas & topologies
# CONTRACTS_DIR=/contracts

# ------------------------------------------------------------------------------
# 2. Control Policy & Network Topology (Graph-Control Service)
# ------------------------------------------------------------------------------
# Topology contract ID (Options: four_intersection_v1, hcm_realworld_v1, multi_phase_v1, three_way_junction_v1)
EDGEFLOW_TOPOLOGY=four_intersection_v1

# Controller policy algorithm (Options: max_pressure, fixed_time)
EDGEFLOW_CONTROLLER=max_pressure

# ------------------------------------------------------------------------------
# 3. Simulator Settings (Simulator Service)
# ------------------------------------------------------------------------------
# Enable SUMO digital twin engine (true/false). If false, uses built-in Python traffic engine.
USE_SUMO=false

# Simulation time step interval in seconds
SIM_INTERVAL_S=1.0

# Telemetry publishing frequency and staleness thresholds (in seconds)
TELEMETRY_PERIOD_S=1
TELEMETRY_STALE_AFTER_S=3

# ------------------------------------------------------------------------------
# 4. API Backend & Dashboard Settings (API Service)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
