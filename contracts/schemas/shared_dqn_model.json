{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared Double DQN model artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "artifact_version",
    "weights",
    "feature_spec",
    "topology_id",
    "timing",
    "training_seeds",
    "provenance"
  ],
  "properties": {
    "algorithm": {
      "const": "shared_dqn"
    },
    "artifact_version": {
      "const": 1
    },
    "weights": {
      "type": "object",
      "required": [
        "w1",
        "w2",
        "b1",
        "b2"
      ],
      "properties": {
        "w1": {
          "type": "array",
          "minItems": 1
        },
        "w2": {
          "type": "array",
          "minItems": 1
        },
        "b1": {
          "type": "array",
          "minItems": 1
        },
        "b2": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "feature_spec": {
      "type": "object"
    },
    "topology_id": {
      "const": "four_intersection_rl_v1"
    },
    "timing": {
      "type": "object"
    },
    "training_seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "network_sha256",
        "topology_sha256",
        "joint_decisions",
        "episodes",
        "training_config_sha256"
      ]
    }
  }
}
