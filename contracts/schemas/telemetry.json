{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "simulation",
        "vision",
        "physical"
      ]
    },
    "simulation_time_s": {
      "type": "number"
    },
    "timestamp_ms": {
      "type": "integer"
    },
    "current_phase_id": {
      "type": "string"
    },
    "approaches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approach_id": {
            "type": "string"
          },
          "queue_vehicles": {
            "type": "number"
          },
          "flow_veh_per_s": {
            "type": "number"
          },
          "mean_speed_mps": {
            "type": "number"
          },
          "occupancy_ratio": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "stopped_wait_sum_s": {
            "type": "number",
            "minimum": 0
          },
          "oldest_stopped_wait_s": {
            "type": "number",
            "minimum": 0
          },
          "external_due_count": {
            "type": "integer",
            "minimum": 0
          },
          "external_wait_sum_s": {
            "type": "number",
            "minimum": 0
          },
          "oldest_external_wait_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "approach_id",
          "queue_vehicles",
          "flow_veh_per_s",
          "mean_speed_mps",
          "occupancy_ratio"
        ]
      }
    },
    "signal_state": {
      "enum": [
        "GREEN",
        "YELLOW",
        "ALL_RED"
      ]
    },
    "pending_phase_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "elapsed_green_s": {
      "type": "number",
      "minimum": 0
    },
    "phase_service_age_s": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "node_id",
    "source_type",
    "approaches",
    "current_phase_id"
  ]
}
