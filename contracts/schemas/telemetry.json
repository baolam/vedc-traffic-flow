{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry",
  "type": "object",
  "properties": {
    "node_id": { "type": "string" },
    "source_type": { "type": "string", "enum": ["simulation", "vision", "physical"] },
    "simulation_time_s": { "type": "number" },
    "timestamp_ms": { "type": "integer" },
    "current_phase_id": { "type": "string" },
    "approaches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approach_id": { "type": "string" },
          "queue_vehicles": { "type": "number" },
          "flow_veh_per_s": { "type": "number" },
          "mean_speed_mps": { "type": "number" },
          "occupancy_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "required": ["approach_id", "queue_vehicles", "flow_veh_per_s", "mean_speed_mps", "occupancy_ratio"]
      }
    }
  },
  "required": ["node_id", "source_type", "approaches", "current_phase_id"]
}
