{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "workers",
    "maps",
    "controllers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "network_path",
          "topology_path",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "network_path": {
            "type": "string"
          },
          "topology_path": {
            "type": "string"
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "balanced",
                "directional_surge",
                "directional_surge_ew",
                "downstream_bottleneck",
                "sparse",
                "near_capacity",
                "oversaturated",
                "directional_reversal"
              ]
            }
          }
        }
      }
    },
    "controllers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "model_path": {
            "type": "string"
          }
        }
      }
    }
  }
}
