{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema", "algorithm", "architecture", "reward_version", "observation", "timing", "topology_id", "weights", "provenance"],
  "properties": {
    "schema": {"const": "unified_dqn_v1"},
    "algorithm": {"enum": ["phase_dqn_unified", "shared_dqn_unified", "presslight_unified"]},
    "architecture": {"enum": ["scalar_phase_scorer", "padded_vector_head"]},
    "reward_version": {"enum": ["wait_tail_v1", "node_pressure_v1"]},
    "observation": {"type": "object", "required": ["version", "features", "radius_hops", "max_phases", "normalization"]},
    "timing": {"type": "object"},
    "topology_id": {"type": "string"},
    "weights": {"type": "object", "required": ["w1", "w2"]},
    "provenance": {"type": "object", "required": ["network_sha256", "topology_sha256", "learner_seed"]},
    "training": {"type": "object"}
  }
}
