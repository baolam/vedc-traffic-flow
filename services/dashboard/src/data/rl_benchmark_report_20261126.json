  "engineering_takeaways": [
    {
      "title": "Why Pure RL Fails in Complex Urban Traffic",
      "detail": "End-to-end unconstrained Deep RL (Phase DQN baseline) suffers from massive sample complexity and exploratory variance. It creates tail delays, unserviced starvation phases, and high seed variance (sd 13.5s on Hanoi)."
    },
    {
      "title": "The Power of EdgeFlow RL (Two-Tier Residual Architecture)",
      "detail": "By anchoring the decision in proven deterministic principles (FlowTheory macroscopic cell transmission and Max-Pressure network queue balance), the Double DQN only overrides actions when high confidence (>5% or >20% Q-value gain) exists. This produces rock-solid seed stability (sd ≤ 0.8s)."
    },
    {
      "title": "The Max-Red Safety Envelope is Essential",
      "detail": "Any heuristic pressure controller left unconstrained eventually causes catastrophic gridlock under non-homogeneous or bottleneck traffic. Enforcing a hard max-red service limit (40s) completely eliminates deadlock in real-world networks."
    },
    {
      "title": "Deployment Strategy",
      "detail": "Use EdgeFlow RL on arterial networks (Jakarta, Cologne, HCM) where coordinated platoon dynamics thrive. Fall back to safety-enveloped deterministic controllers (or tuned actuated) during extreme oversaturation."
    }
  ]
}
