<?xml version="1.0" encoding="UTF-8"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- J1: NS and EW straight arterial movements -->
    <connection from="J1_N_IN" to="J4_N_IN" fromLane="0" toLane="0"/>
    <connection from="J1_S_IN" to="J1_N_OUT" fromLane="0" toLane="0"/>
    <connection from="J1_W_IN" to="J2_W_IN" fromLane="0" toLane="0"/>
    <connection from="J1_E_IN" to="J1_W_OUT" fromLane="0" toLane="0"/>

    <!-- J2: NS and EW straight arterial movements -->
    <connection from="J2_N_IN" to="J5_N_IN" fromLane="0" toLane="0"/>
    <connection from="J2_S_IN" to="J2_N_OUT" fromLane="0" toLane="0"/>
    <connection from="J2_W_IN" to="J3_W_IN" fromLane="0" toLane="0"/>
    <connection from="J2_E_IN" to="J1_E_IN" fromLane="0" toLane="0"/>

    <!-- J3: NS and EW straight arterial movements -->
    <connection from="J3_N_IN" to="J3_S_OUT" fromLane="0" toLane="0"/>
    <connection from="J3_S_IN" to="J3_N_OUT" fromLane="0" toLane="0"/>
    <connection from="J3_W_IN" to="J3_E_OUT" fromLane="0" toLane="0"/>
    <connection from="J3_E_IN" to="J2_E_IN" fromLane="0" toLane="0"/>

    <!-- J4: NS and EW straight arterial movements -->
    <connection from="J4_N_IN" to="J4_S_OUT" fromLane="0" toLane="0"/>
    <connection from="J4_S_IN" to="J1_S_IN" fromLane="0" toLane="0"/>
    <connection from="J4_W_IN" to="J5_W_IN" fromLane="0" toLane="0"/>
    <connection from="J4_E_IN" to="J4_W_OUT" fromLane="0" toLane="0"/>

    <!-- J5: NS and EW straight arterial movements -->
    <connection from="J5_N_IN" to="J5_S_OUT" fromLane="0" toLane="0"/>
    <connection from="J5_S_IN" to="J2_S_IN" fromLane="0" toLane="0"/>
    <connection from="J5_W_IN" to="J5_E_OUT" fromLane="0" toLane="0"/>
    <connection from="J5_E_IN" to="J4_E_IN" fromLane="0" toLane="0"/>

    <!-- RES_P (Southeast Priority Junction into Parking) -->
    <connection from="J3_S_OUT" to="RES_TO_PARKING" fromLane="0" toLane="0"/>
    <connection from="J5_E_OUT" to="RES_TO_PARKING" fromLane="0" toLane="0"/>
    <connection from="PARKING_TO_RES" to="J3_S_IN" fromLane="0" toLane="0"/>
    <connection from="PARKING_TO_RES" to="J5_E_IN" fromLane="0" toLane="0"/>
</connections>
