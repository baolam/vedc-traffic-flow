<?xml version="1.0" encoding="UTF-8"?>
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    <!-- Wide, distinct roads (width="5.0") following four_intersection_v1 structure -->

    <!-- J1 boundary legs -->
    <edge id="J1_N_IN"  from="N1" to="J1" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J1_N_OUT" from="J1" to="N1" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J1_W_IN"  from="W1" to="J1" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J1_W_OUT" from="J1" to="W1" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <!-- J2 boundary legs -->
    <edge id="J2_N_IN"  from="N2" to="J2" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J2_N_OUT" from="J2" to="N2" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <!-- J3 boundary legs -->
    <edge id="J3_N_IN"  from="N3" to="J3" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J3_N_OUT" from="J3" to="N3" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J3_E_IN"  from="E3" to="J3" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J3_E_OUT" from="J3" to="E3" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <!-- J4 boundary legs -->
    <edge id="J4_S_IN"  from="S4" to="J4" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J4_S_OUT" from="J4" to="S4" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J4_W_IN"  from="W4" to="J4" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J4_W_OUT" from="J4" to="W4" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <!-- J5 boundary legs -->
    <edge id="J5_S_IN"  from="S5" to="J5" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J5_S_OUT" from="J5" to="S5" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <!-- Internal Grid Connections -->
    <!-- Top Horizontal: J1 <-> J2 <-> J3 -->
    <edge id="J2_W_IN" from="J1" to="J2" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J1_E_IN" from="J2" to="J1" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J3_W_IN" from="J2" to="J3" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J2_E_IN" from="J3" to="J2" priority="3" numLanes="1" speed="13.89" width="5.0"/>

    <!-- Bottom Horizontal: J4 <-> J5 -->
    <edge id="J5_W_IN" from="J4" to="J5" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J4_E_IN" from="J5" to="J4" priority="3" numLanes="1" speed="13.89" width="5.0"/>

    <!-- West Vertical: J1 <-> J4 -->
    <edge id="J4_N_IN" from="J1" to="J4" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J1_S_IN" from="J4" to="J1" priority="3" numLanes="1" speed="13.89" width="5.0"/>

    <!-- Central Vertical: J2 <-> J5 -->
    <edge id="J5_N_IN" from="J2" to="J5" priority="3" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J2_S_IN" from="J5" to="J2" priority="3" numLanes="1" speed="13.89" width="5.0"/>

    <!-- Southeast Residential & Parking Area -->
    <edge id="J3_S_OUT" from="J3" to="RES_P" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J3_S_IN"  from="RES_P" to="J3" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J5_E_OUT" from="J5" to="RES_P" priority="2" numLanes="1" speed="13.89" width="5.0"/>
    <edge id="J5_E_IN"  from="RES_P" to="J5" priority="2" numLanes="1" speed="13.89" width="5.0"/>

    <edge id="RES_TO_PARKING" from="RES_P" to="PARKING" priority="1" numLanes="1" speed="11.11" width="5.0"/>
    <edge id="PARKING_TO_RES" from="PARKING" to="RES_P" priority="1" numLanes="1" speed="11.11" width="5.0"/>
</edges>
