<?xml version="1.0" encoding="UTF-8"?>
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">
    <!-- Two signalized intersections (J1 west, J2 east) matching the 1200x600 mm tabletop mat -->
    <node id="J1" x="150" y="150" type="traffic_light"/>
    <node id="J2" x="450" y="150" type="traffic_light"/>

    <!-- J1 boundary nodes: 150m arms (matching 300mm on sa ban) -->
    <node id="W1" x="0"   y="150" type="priority"/>
    <node id="N1" x="150" y="300" type="priority"/>
    <node id="S1" x="150" y="0"   type="priority"/>

    <!-- J2 boundary nodes: 150m arms (matching 300mm on sa ban) -->
    <node id="E2" x="600" y="150" type="priority"/>
    <node id="N2" x="450" y="300" type="priority"/>
    <node id="S2" x="450" y="0"   type="priority"/>
</nodes>
