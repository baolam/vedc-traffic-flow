Color=#1F1F1F;" vertex="1" parent="pi"><mxGeometry x="25" y="50" width="350" height="62" as="geometry"/></mxCell><mxCell id="p_cap" value='&lt;b style="font-size:13px"&gt;Thu ảnh (Picamera2)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;toàn khung cảm biến 2304×1296 → 1280×720&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A8;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="pi"><mxGeometry x="25" y="132" width="350" height="62" as="geometry"/></mxCell><mxCell id="p_det" value='&lt;b style="font-size:13px"&gt;Phát hiện xe — YOLO11n&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;ONNX qua OpenCV DNN, CPU 4× Cortex-A76&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A8;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="pi"><mxGeometry x="25" y="214" width="350" height="62" as="geometry"/></mxCell><mxCell id="p_roi" value='&lt;b style="font-size:13px"&gt;Gán xe vào ROI từng hướng&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;1 camera phủ 2 nút: J1_N_IN … J2_W_IN&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A8;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="pi"><mxGeometry x="25" y="296" width="350" height="62" as="geometry"/></mxCell><mxCell id="p_win" value='&lt;b style="font-size:13px"&gt;Tổng hợp mỗi 1 giây&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;trung vị hàng đợi · lưu lượng · độ tin cậy&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A8;strokeWidth=1.4;fontFamily=Helvetic