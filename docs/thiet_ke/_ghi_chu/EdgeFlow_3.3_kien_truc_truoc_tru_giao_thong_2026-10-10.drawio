=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="600" y="964" width="260" height="32" as="geometry"/></mxCell><mxCell id="tbl_r2c3" value="mỗi chu kỳ quyết định: pha đích, min/max green" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="860" y="964" width="800" height="32" as="geometry"/></mxCell><mxCell id="tbl_r3c0" value="edgeflow/v1/control/{node}/ack" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Menlo;fontSize=11;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="340" height="32" as="geometry"/></mxCell><mxCell id="tbl_r3c1" value="ESP32" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="380" y="996" width="220" height="32" as="geometry"/></mxCell><mxCell id="tbl_r3c2" value="ghi log kiểm chứng (*)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="600" y="996" width="260" height="32" as="geometry"/></mxCell><mxCell id="tbl_r3c3" value="ACCEPTED → APPLIED, hoặc REJECTED / EXPIRED / FAILED" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="860" y="996" width="800" height="32" as="geometry"/></mxCell><mxCell id="tbl_r4c0" value="edgeflow/v1/health/{node}" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Menlo;fontSize=11;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="1028" width="340" height="32" as="geometry"/></mxCell><mxCell id="tbl_r4c1" value="ESP32" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="380" y="1028" width="220" height="32" as="geometry"/></mxCell><mxCell id="tbl_r4c2" value="vision (phase_tracker)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="600" y="1028" width="260" height="32" as="geometry"/></mxCell><mxCell id="tbl_r4c3" value="mỗi 5 s và mỗi lần vào GREEN; LWT OFFLINE khi mất kết nối" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="860" y="1028" width="800" height="32" as="geometry"/></mxCell><mxCell id="tbl_r5c0" value="edgeflow/v1/health/vision" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Menlo;fontSize=11;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="340" height="32" as="geometry"/></mxCell><mxCell id="tbl_r5c1" value="vision (Pi)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="380" y="1060" width="220" height="32" as="geometry"/></mxCell><mxCell id="tbl_r5c2" value="giám sát" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="600" y="1060" width="260" height="32" as="geometry"/></mxCell><mxCell id="tbl_r5c3" value="retained: FPS, độ trễ xử lý, trạng thái phần cứng; LWT OFFLINE" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontStyle=0;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="860" y="1060" width="800" height="32" as="geometry"/></mxCell><mxCell id="tbl_note" value="(*) graph-control và api hiện chưa đăng ký topic ack; ACK được ghi lại bằng mosquitto_sub để làm bằng chứng. Mỗi ESP32 chỉ nhận lệnh có node_id của chính nó." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#555555;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1098" width="1620" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="H3.4 Máy trạng thái an toàn"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp" value="CHU TRÌNH ĐỔI PHA AN TOÀN — thời gian do thiết bị quyết định, bộ điều khiển không rút ngắn được" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E9F6EE;strokeColor=#2F7D4F;strokeWidth=1.8;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2F7D4F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1020" height="620" as="geometry"/></mxCell><mxCell id="st_green" value='&lt;b style="font-size:15px"&gt;GREEN — pha P&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;min green ≥ 5 s · max green ≤ 60 s&lt;br&gt;hướng của P xanh, hướng còn lại đỏ&lt;/span&gt;' style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#DDF2E3;strokeColor=#2F7D4F;strokeWidth=2.2;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="250" height="110" as="geometry"/></mxCell><mxCell id="st_yellow" value='&lt;b style="font-size:15px"&gt;YELLOW&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;3 s · hướng đang xanh chuyển vàng&lt;/span&gt;' style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF2CF;strokeColor=#B7791F;strokeWidth=2.2;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="st_allred" value='&lt;b style="font-size:15px"&gt;ALL_RED&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;2 s · mọi hướng đỏ&lt;/span&gt;' style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FCE1E1;strokeColor=#C0392B;strokeWidth=2.2;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="250" height="100" as="geometry"/></mxCell><mxCell id="st_safe" value='&lt;b style="font-size:15px"&gt;SAFE_STOP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#FFE9E9"&gt;mọi đèn vàng nhấp nháy (0,5 s sáng / 0,5 s tắt)&lt;br&gt;mọi lệnh → REJECTED&lt;/span&gt;' style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#7F1D1D;strokeWidth=2.2;fontFamily=Helvetica;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="300" height="120" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Đổi pha khi:&lt;/b&gt;&lt;br&gt;• có lệnh hợp lệ, đã đủ min green → ACK ACCEPTED&lt;br&gt;• hoặc đạt max green 60 s&lt;br&gt;• hoặc fallback: hết 15 s xanh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_green" target="st_yellow"><mxGeometry x="0.15" relative="1" as="geometry"><mxPoint x="0" y="-40" as="offset"/><Array as="points"><mxPoint x="425" y="180"/></Array></mxGeometry></mxCell><mxCell id="t2" value="sau 3 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_yellow" target="st_allred"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t3" value="sau 2 s → GREEN pha đích&lt;br&gt;ACK APPLIED + gửi health" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_allred" target="st_green"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="0" y="26" as="offset"/><Array as="points"><mxPoint x="425" y="570"/></Array></mxGeometry></mxCell><mxCell id="t4" value="lệnh cùng pha&lt;br&gt;→ APPLIED, gia hạn xanh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_green" target="st_green"><mxGeometry relative="1" as="geometry"><mxPoint x="-80" y="0" as="offset"/><Array as="points"><mxPoint x="250" y="363"/><mxPoint x="250" y="412.5"/></Array></mxGeometry></mxCell><mxCell id="fb_note" value='&lt;b style="font-size:13px"&gt;Chế độ FALLBACK&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;không nhận lệnh &amp;gt; 5 s → tự đổi pha sau mỗi 15 s xanh, vẫn đi qua YELLOW → ALL_RED, không gửi ACK.&lt;br&gt;Có lệnh mới → thoát fallback.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="585" y="285" width="270" height="170" as="geometry"/></mxCell><mxCell id="start" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#1F1F1F;strokeColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="873" y="735" width="24" height="24" as="geometry"/></mxCell><mxCell id="t0" value="cấp nguồn hoặc reset&lt;br&gt;(watchdog phần cứng 10 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="st_allred"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint x="110" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="t5" value="nhấn safe-stop&lt;br&gt;(GPIO 4 = LOW ≥ 50 ms)&lt;br&gt;lệnh đang chờ → FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C0392B;strokeWidth=2.2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#7F1D1D;labelBackgroundColor=#FFFFFF;spacing=2;exitX=1;exitY=0.532;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="grp" target="st_safe"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-46" as="offset"/></mxGeometry></mxCell><mxCell id="t6" value="nhả nút → ALL_RED 2 s&lt;br&gt;rồi xanh lại pha cũ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C0392B;strokeWidth=2.2;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=12;fontColor=#7F1D1D;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_safe" target="st_allred"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/><Array as="points"><mxPoint x="1410" y="600"/></Array></mxGeometry></mxCell><mxCell id="rej" value='&lt;b style="font-size:13px"&gt;Lệnh bị từ chối thì đèn giữ nguyên trạng thái&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;• pha không thuộc nút, JSON sai → REJECTED&lt;br&gt;• đang chuyển sang pha khác → REJECTED&lt;br&gt;• chưa đủ min green → REJECTED&lt;br&gt;• quá hạn (khi lệnh có expires_at_ms và đồng hồ đã đồng bộ) → EXPIRED&lt;br&gt;• lệnh gửi cho nút khác → bỏ qua&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="700" height="150" as="geometry"/></mxCell><mxCell id="out_r0c0" value="Trạng thái" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EDEDED;strokeColor=#BDBDBD;align=left;verticalAlign=middle;spaci