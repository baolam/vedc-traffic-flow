el dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a_ac" value='&lt;b style="font-size:13px"&gt;Ổ cắm 220 V AC&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B66;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="56" as="geometry"/></mxCell><mxCell id="a_pipsu" value='&lt;b style="font-size:13px"&gt;Nguồn Raspberry Pi 27 W&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;USB-C PD · 5,1 V / 5 A&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C05621;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="70" as="geometry"/></mxCell><mxCell id="a_adp" value='&lt;b style="font-size:13px"&gt;Adapter 5 V / 4 A&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;đầu DC 5.5 × 2.1 mm&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C05621;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="300" height="70" as="geometry"/></mxCell><mxCell id="a_jack" value='&lt;b style="font-size:13px"&gt;Jack DC cái → domino&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;đường 5 V chung cho 2 nút&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C05621;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middl