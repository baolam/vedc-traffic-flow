;strokeColor=#2563A8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#2563A8;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="p_roi" target="p_win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe_p_win" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563A8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#2563A8;labelBackgroundColor=#FFFFFF;spacing=2;" edge="1" parent="1" source="p_win" target="p_pub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lap" value="LAPTOP ĐIỀU PHỐI — DOCKER COMPOSE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F2EEFA;strokeColor=#6B46C1;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#6B46C1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="520" height="560" as="geometry"/></mxCell><mxCell id="l_broker" value='&lt;b style="font-size:13px"&gt;MQTT Broker — Eclipse Mosquitto 2.0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;cổng 1883 · mọi topic có tiền tố edgeflow/v1/&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5E1;strokeColor=#B7791F;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="lap"><mxGeometry x="25" y="50" width="470" height="70" as="geometry"/></mxCell><mxCell id="l_gc" value='&lt;b style="font-size:13px"&gt;Graph-Control&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;điều khiển trên đồ thị mạng lưới&lt;br&gt;&lt;b&gt;MaxPressure · EdgeFlow&lt;/b&gt;&lt;br&gt;(Fixed-Time, MaxQueue làm mốc)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="lap"><mxGeometry x="25" y="210" width="225" height="120" as="geometry"/></mxCell><mxCell id="l_api" value='&lt;b style="font-size:13px"&gt;API — FastAPI :8000&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;topology · trạng thái mạng&lt;br&gt;đổi bộ điều khiển · thí nghiệm&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="lap"><mxGeometry x="270" y="210" width="225" height="120" as="geometry"/></mxCell><mxCell id="l_contracts" value='&lt;b style="font-size:13px"&gt;contracts/&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;JSON Schema + topology J1–J2&lt;br&gt;dùng chung cho mọi khối&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;dashed=1;dashPattern=6 4;" vertex="1" parent="lap"><mxGeometry x="25" y="390" width="225" height="70" as="geometry"/></mxCell><mxCell id="l_dash" value='&lt;b style="font-size:13px"&gt;Dashboard — React :3000&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;giám sát kiểu trung tâm IOC&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="lap"><mxGeometry x="270" y="390" width="225" height="70" as="geometry"/></mxCell><mxCell id="l_sumo" value='&lt;b style="font-size:13px"&gt;SUMO + actuator ảo (chế độ mô phỏng)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;cùng hợp đồng dữ liệu · tắt khi chạy phần cứng&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;dashed=1;dashPattern=6 4;" vertex="1" parent="lap"><mxGeometry x="25" y="480" width="470" height="56" as="geometry"/></mxCell><mxCell id="esp" value="2× ESP32 NodeMCU-32S — NÚT ĐÈN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E9F6EE;strokeColor=#2F7D4F;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#2F7D4F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1240" y="230" width="420" height="560" as="geometry"/></mxCell><mxCell id="e1" value='&lt;b style="font-size:13px"&gt;ESP32 J1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;• kiểm lệnh: nút, pha, hạn, min green&lt;br&gt;• đổi pha an toàn:&lt;br&gt;&amp;nbsp;&amp;nbsp;vàng 3 s → đỏ toàn phần 2 s&lt;br&gt;• mất lệnh &amp;gt; 5 s → tự chạy 15 s/pha&lt;br&gt;• gửi ACK + health&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="esp"><mxGeometry x="15" y="50" width="220" height="220" as="geometry"/></mxCell><mxCell id="e1_led" value='&lt;b style="font-size:13px"&gt;4 module đèn&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;Bắc + Nam: GPIO 23/22/21&lt;br&gt;Đông + Tây: GPIO 19/18/5&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2F7D4F;strokeWidth=1.4;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="esp"><mxGeometry x="250" y="5