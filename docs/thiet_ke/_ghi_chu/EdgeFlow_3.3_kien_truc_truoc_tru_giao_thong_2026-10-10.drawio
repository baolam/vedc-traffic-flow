&lt;br&gt;&lt;br&gt;&lt;b&gt;Mức logic&lt;/b&gt;&lt;br&gt;GPIO 3,3 V&lt;br&gt;&lt;br&gt;&lt;b&gt;Đèn&lt;/b&gt;&lt;br&gt;Bắc và Nam cùng pha nên mắc song song trên 3 chân; Đông và Tây cũng vậy. ~6 mA/LED ở 3,3 V, ~12 mA/chân' style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2F2F2F;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="c_esp"><mxGeometry x="15" y="70" width="170" height="330" as="geometry"/></mxCell><mxCell id="pin_ns" value='&lt;b style="font-size:12px"&gt;GPIO 23 / 22 / 21&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;R / Y / G — pha Bắc–Nam&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;strokeWidth=1.4;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="c_esp"><mxGeometry x="200" y="60" width="150" height="50" as="geometry"/></mxCell><mxCell id="pin_ew" value='&lt;b style="font-size:12px"&gt;GPIO 19 / 18 / 5&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;R / Y / G — pha Đông–Tây&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;strokeWidth=1.4;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="c_esp"><mxGeometry x="200" y="200" width="150" height="50" as="geometry"/></mxCell><mxCell id="pin_stop" value='&lt;b style="font-size:12px"&gt;GPIO 4&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#4A4A4A"&gt;safe-stop · INPUT_PULLUP&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.4;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="c_esp"><mxGeometry x="200" y="340" width="150" height="50" as="geometry"/></mxCell><m