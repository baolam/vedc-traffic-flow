<mxfile host="drawio" agent="EdgeFlow AI report generator" version="24.0.0"><diagram id="page-1" name="A.1 Nguyên lý nút chấp hành"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1110" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="vung_tru" value="Trên trụ J1 · cụm đèn 4 mặt" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#6B46C1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#6B46C1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1250" y="112" width="315" height="655" as="geometry"/></mxCell><mxCell id="w1" value="" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#6B46C1;strokeWidth=1.3;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#6B46C1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="1150" y="160" width="50" height="580" as="geometry"/></mxCell><mxCell id="w1_ten" value="&lt;b&gt;W1&lt;/b&gt; · cáp 8 lõi&lt;br&gt;lên trụ (~1,2 m)" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#6B46C1;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1112" y="120" width="126" height="36" as="geometry"/></mxCell><mxCell id="ghi_chu" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Bắc và Nam cùng pha nên mắc &lt;b&gt;song song&lt;/b&gt; trên 3 chân IO23/22/21; Đông và Tây trên IO19/18/5.&lt;br&gt;• Module đèn có sẵn trở hạn dòng. Dòng ước tính ~6 mA mỗi LED ở 3,3 V, tức ~12 mA mỗi chân GPIO (2 module song song).&lt;br&gt;• S1: GPIO 4 dùng điện trở kéo lên nội (INPUT_PULLUP). Nhấn = LOW = dừng an toàn: vàng nhấp nháy, từ chối lệnh.&lt;br&gt;• IO2 là LED trạng thái có sẵn trên board.&lt;br&gt;• Nạp firmware qua micro-USB (CH340): rút nguồn 5 V ngoài trước khi cắm cáp.&lt;br&gt;• Mọi ký hiệu GND là GND chung của nút J1 và J2. Pi 5 dùng nguồn riêng, không chung GND (Hình A.2).&lt;br&gt;• W1: cáp 8 lõi từ breadboard lên cụm đèn trên trụ, chi tiết ở Hình A.3." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1F1F1F;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="480" height="330" as="geometry"/></mxCell><mxCell id="u1" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2F7D4F;strokeWidth=2;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="250" height="518" as="geometry"/></mxCell><mxCell id="u1_ten" value="&lt;b&gt;U1&lt;/b&gt; · ESP32 NodeMCU-32S (Ai-Thinker)" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#1F1F1F;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="174" width="250" height="20" as="geometry"/></mxCell><mxCell id="u1_phu" value="nhìn từ mặt linh kiện, anten ở trên" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#555555;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="196" width="250" height="18" as="geometry"/></mxCell><mxCell id="u1_giua" value="ESP-WROOM-32&lt;br&gt;2 nhân 240 MHz&lt;br&gt;Wi-Fi 2.4 GHz&lt;br&gt;&lt;br&gt;mức logic 3,3 V" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#2F7D4F;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="678" y="401" width="94" height="150" as="geometry"/></mxCell><m