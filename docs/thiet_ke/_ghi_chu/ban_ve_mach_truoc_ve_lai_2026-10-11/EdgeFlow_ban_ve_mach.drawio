dgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6B6B66;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=11;fontColor=#6B6B66;labelBackgroundColor=#FFFFFF;spacing=2;startArrow=block;startFill=1;startSize=7;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="router" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ghi_chu" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Hai miền nguồn tách riêng: Pi 5 dùng nguồn USB-C 27 W; hai ESP32 và module đèn dùng adapter 5 V (Hình A.1).&lt;br&gt;• Pi và ESP32 &lt;b&gt;không nối dây&lt;/b&gt;, kể cả GND. Hai bên chỉ trao đổi qua Wi-Fi / MQTT.&lt;br&gt;• Cáp kèm camera là loại 15–15 pin, không cắm được vào Pi 5; cần cáp FPC 22 → 15 pin.&lt;br&gt;• Đọc 2 camera trên 1 Pi: phần cứng có sẵn 2 cổng CSI, phần mềm đang phát triển." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1F1F1F;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="350" height="250" as="geometry"/></mxCell><mxCell id="cg_0_w" value="" style="endArrow=none;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#C05621;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="860" as="sourcePoint"/><mxPoint x="74" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cg_0_t" value="Nguồn điện" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1F1F1F;align=left;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="850" width="210" height="20" as="geometry"/></mxCell><mxCell id="cg_1_w" value="" style="endArrow=none;endFill=1;endSize=7;html=1;rounded=0;strokeColor=#6B6B66;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="860" as="sourcePoint"/><mxPoint x="324" y="860" as="targ