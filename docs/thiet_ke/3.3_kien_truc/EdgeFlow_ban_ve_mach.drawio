5;fontColor=#1E2329;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="338" y="271" width="112" height="23" as="geometry"/></mxCell><mxCell id="bth_vien" value="" style="rounded=0;absoluteArcSize=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A3ABB5;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="86" width="400" height="208" as="geometry"/></mxCell><mxCell id="gc_td" value='&lt;span style="letter-spacing:0.08em"&gt;GHI CHÚ&lt;/span&gt;' style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="400" height="16" as="geometry"/></mxCell><mxCell id="gc_vach" value="" style="endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;html=1;rounded=0;strokeColor=#D5DAE0;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#D5DAE0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="341" as="sourcePoint"/><mxPoint x="450" y="341" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gc_1_so" value="1." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_1" value="Bắc và Nam cùng pha nên mắc &lt;b&gt;song song&lt;/b&gt; trên IO23/22/21; Đông và Tây trên IO19/18/5. Điểm rẽ nhánh nằm ở đầu cần đèn (A.4)." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="350" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="gc_2_so" value="2." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="387.36" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_2" value="Module đèn có sẵn điện trở hạn dòng. Dòng ước tính ~6 mA mỗi LED ở 3,3 V, tức ~12 mA mỗi chân GPIO." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="387.36" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="gc_3_so" value="3." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="424.72" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_3" value="S1 dùng điện trở kéo lên nội (INPUT_PULLUP). Nhấn = LOW = dừng an toàn: vàng nhấp nháy, từ chối lệnh." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="424.72" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="gc_4_so" value="4." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="462.08000000000004" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_4" value="IO2 là LED trạng thái có sẵn trên board." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="462.08000000000004" width="378" height="17.18" as="geometry"/></mxCell><mxCell id="gc_5_so" value="5." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="484.26000000000005" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_5" value="Nạp firmware qua micro-USB (CH340): rút nguồn 5 V ngoài trước khi cắm cáp." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="484.26000000000005" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="gc_6_so" value="6." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="521.62" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_6" value="Mọi ký hiệu GND là GND chung của nút J1 và J2. Pi 5 dùng nguồn riêng, không chung GND (A.3)." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="521.62" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="gc_7_so" value="7." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="558.98" width="20" height="15.399999999999999" as="geometry"/></mxCell><mxCell id="gc_7" value="X3 (tùy chọn): header để kẹp logic analyzer song song lên các net trong bảng." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="72" y="558.98" width="378" height="32.36" as="geometry"/></mxCell><mxCell id="w1" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8F0FC;strokeColor=#AE3EC9;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#1E2329;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="160" width="34" height="724" as="geometry"/></mxCell><mxCell id="w1_ten" value='&lt;b style="font-size:13px"&gt;W1&lt;/b&gt; · CAT5e&lt;br&gt;8 lõi · ~1,2 m' style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#AE3EC9;align=right;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="144" height="40" as="geometry"/></mxCell><mxCell id="u1_ten" value="&lt;b&gt;U1&lt;/b&gt; · ESP32 NodeMCU-32S" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1E2329;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="490" y="112" width="310" height="20" as="geometry"/></mxCell><mxCell id="u1_phu" value="Ai-Thinker · 38 chân · nhìn từ mặt linh kiện" style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=center;verticalAlign=middle;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="480" y="132" width="330" height="16" as="geometry"/></mxCell><mxCell id="u1" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=