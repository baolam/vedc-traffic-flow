"16" as="geometry"/></mxCell><mxCell id="gc_vach" value="" style="endArrow=none;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;html=1;rounded=0;strokeColor=#D5DAE0;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontColor=#D5DAE0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="596" as="sourcePoint"/><mxPoint x="1550" y="596" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gc_1_so" value="1." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="605" width="20" height="14.7" as="geometry"/></mxCell><mxCell id="gc_1" value="Hai miền nguồn tách riêng: Pi 5 dùng nguồn USB-C 27 W (P4); hai ESP32 và 8 module đèn dùng chung adapter 5 V (P1–P3)." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="605" width="468" height="30.979999999999997" as="geometry"/></mxCell><mxCell id="gc_2_so" value="2." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="640.98" width="20" height="14.7" as="geometry"/></mxCell><mxCell id="gc_2" value="Pi và ESP32 &lt;b&gt;không nối dây nào&lt;/b&gt;, kể cả GND. Hai bên chỉ trao đổi qua Wi-Fi / MQTT trong LAN riêng của R1." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="640.98" width="468" height="30.979999999999997" as="geometry"/></mxCell><mxCell id="gc_3_so" value="3." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="676.96" width="20" height="14.7" as="geometry"/></mxCell><mxCell id="gc_3" value="Nét đứt: cáp W1, W2 đi dưới mặt sa bàn, chui lên qua lỗ ở chân trụ." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="676.96" width="468" height="16.49" as="geometry"/></mxCell><mxCell id="gc_4_so" value="4." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="698.45" width="20" height="14.7" as="geometry"/></mxCell><mxCell id="gc_4" value="Vị trí, kích thước và độ dài cáp là phương án đề xuất, chưa phải số đo trên sa bàn thật." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="698.45" width="468" height="16.49" as="geometry"/></mxCell><mxCell id="gc_5_so" value="5." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5B6470;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="719.94" width="20" height="14.7" as="geometry"/></mxCell><mxCell id="gc_5" value="Đọc 2 camera trên 1 Pi: phần cứng có sẵn 2 cổng CSI, phần mềm đang phát triển." style="text=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E2329;align=left;verticalAlign=top;fontStyle=0;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1082" y="719.94" width="468" height="16.49" as="g