# ==============================================================================
# EdgeFlow AI - Raspberry Pi 5 Distributed Deployment Configuration (.env.rpi)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Infrastructure Settings
# ------------------------------------------------------------------------------
EDGEFLOW_ENV=prod
EDGEFLOW_SCHEMA_VERSION=1.0
LOG_LEVEL=INFO

# IP Address of the Central MQTT Broker (Laptop Server IP on LAN, e.g. 192.168.1.100)
# Set to 'mqtt' or 'localhost' if running Mosquitto locally on Raspberry Pi
# Changing network (home Wi-Fi -> phone hotspot)? src/hardware/set_network.sh prints the laptop IP to put here.
MQTT_HOST=192.168.1.100
MQTT_PORT=1883

# ------------------------------------------------------------------------------
# 2. Vision Perception Configuration (services/vision)
# ------------------------------------------------------------------------------
# Target intersection node that this Raspberry Pi camera monitors
VISION_NODE_ID=J1
# One camera covering both corridor intersections: list them here (overrides VISION_NODE_ID)
# and point ROI_CONFIG_PATH at the polygons drawn with services/vision/roi_calibrate.py.
# The example file is NOT calibrated for a real camera - redraw it after mounting the camera.
#VISION_NODE_IDS=J1,J2
#ROI_CONFIG_PATH=services/vision/rois/example_two_nodes_1280x720.json

# Video input source:
# - 'picamera' for Raspberry Pi Camera Module 3 on the CSI port (Picamera2/libcamera).
#   On Pi 5 this is the ONLY working path for the CSI camera; '/dev/video0' will not
#   deliver frames from it. Needs native run (infra/rpi/setup_pi.sh), not the Docker image.
# - '0' or '/dev/video0' for a USB webcam / V4L2 device
# - 'synthetic' for built-in test pattern
# - Path to video file: '/app/data/sample_traffic.mp4'
VIDEO_SOURCE=picamera

# Camera Module 3 controls (Picamera2 only)
# Fixed focus in dioptres = 1 / distance_m (camera ~0.5 m above the tabletop -> ~2.0).
# Leave empty to keep autofocus (focus "breathing" shifts the ROIs - lock it for demos).
CAMERA_LENS_POSITION=2.0
# Anti-flicker period in microseconds: 10000 = 50 Hz mains lighting, 0 = off
CAMERA_FLICKER_PERIOD_US=10000

# Processing cap on Raspberry Pi 5: frames are processed continuously up to this rate
# (0 = as fast as the CPU allows). Measure the real rate with benchmark.py / the health topic.
VISION_FPS=10.0

# Telemetry publishing interval in seconds. Each message carries, per approach, the median over the
# frames processed in the period; confidence = share of those frames that were captured and processed.
TELEMETRY_PERIOD_S=1.0

# AI Model settings for Pi 5 CPU (OpenCV DNN, raw YOLOv8/YOLO11 ONNX export without NMS)
# Native run (systemd, working dir = repo root): models/yolo11n.onnx
# Docker run (./models mounted at /models):      /models/yolo11n.onnx
DETECTION_MODEL_PATH=models/yolo11n.onnx
CONFIDENCE_THRESHOLD=0.4
DETECTOR_INPUT_SIZE=640
DETECTOR_OUTPUT_FORMAT=yolov8
DETECTOR_NUM_CLASSES=80
DETECTOR_VEHICLE_CLASSES=2,3,5,7
MOTION_SCALE=1.0

# Hardware Telemetry: Read Pi 5 CPU thermal & throttling stats
ENABLE_HARDWARE_TELEMETRY=true

# Optional Video Sync (services/vision/video_sync.py): alongside the normal MQTT telemetry
# above, also push short annotated video clips of this camera's feed to the platform API over
# HTTP (POST /api/v1/vision/video-upload), so the dashboard's Raspberry Pi Demo page can replay
# them. Off by default - only needed for the dashboard "Raspberry Pi Demo" page (node J3,
# topology rpi_demo_v1). Never affects MQTT telemetry; safe to leave disabled otherwise.
#VIDEO_SYNC_ENABLED=true
#VIDEO_SYNC_API_URL=http://192.168.1.100:8000
#VIDEO_SYNC_PERIOD_S=10.0
#VIDEO_SYNC_FPS=10.0
# Uploaded clip is filed under this topology_id; leave unset to reuse EDGEFLOW_TOPOLOGY below.
#VIDEO_SYNC_TOPOLOGY_ID=rpi_demo_v1

# --- Raspberry Pi Demo (dashboard page, no real intersection - see contracts/topology/rpi_demo_v1.json) ---
# Uncomment to point this Pi's vision service at the dashboard's standalone demo node instead of
# a real corridor junction. VISION_NODE_ID=J3 here only means "node J3 inside rpi_demo_v1", not
# the J3 in four_intersection_v1 - each topology contract has its own independent node namespace.
#VISION_NODE_ID=J3
#EDGEFLOW_TOPOLOGY=rpi_demo_v1
#VIDEO_SYNC_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Graph Control Configuration (services/graph-control)
# ------------------------------------------------------------------------------
# Active topology contract. The tabletop has only J1 and J2: tabletop_j1_j2_v1 matches it
# (same approach/phase IDs as four_intersection_v1, without the J3/J4 that never report).
# Laptop .env (graph-control, api) must use the same value.
EDGEFLOW_TOPOLOGY=tabletop_j1_j2_v1

# Control Algorithm (edgeflow, max_pressure, max_queue, fixed_time). Graph-control runs on the laptop and
# reads the laptop .env; this line only matters if graph-control is run on the Pi. Semifinal demo: edgeflow.
EDGEFLOW_CONTROLLER=edgeflow
RL_MODEL_PATH=/models/rl_agent.npy

# ------------------------------------------------------------------------------
# 4. API Backend & Dashboard (Optional for standalone Edge mode)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
REACT_APP_API_URL=http://localhost:8000

# --- Video-file demo (Semifinal, no physical camera; decided 17/10) ---
# Later lines win (systemd EnvironmentFile and preflight.sh both take the last value), so just uncomment
# this block; it overrides VIDEO_SOURCE, the model and the class settings above. The video is a Blender render of
# both junctions, so the model must be the one fine-tuned on it (1 class), not COCO (COCO finds ~0 cars).
# Open loop: the cars in the video do not stop for the real LEDs. Say so in the report.
#VIDEO_SOURCE=data/demo_video/video_demo_150s.mp4
#VISION_NODE_IDS=J1,J2
#ROI_CONFIG_PATH=services/vision/rois/rois_video_1280x720.json
#DETECTION_MODEL_PATH=models/yolo11n_sa_ban.onnx
#DETECTOR_INPUT_SIZE=640
#DETECTOR_NUM_CLASSES=1
#DETECTOR_VEHICLE_CLASSES=0
#VISION_FPS=10.0
# Pi too slow (journal "Runtime: processed ... fps" below ~3)? Same weights at 416 px, about 2x faster on the Mac,
# recall unchanged on the val video (precision 0.963 vs 0.988). The input size must match the export:
#DETECTION_MODEL_PATH=models/yolo11n_sa_ban_416.onnx
#DETECTOR_INPUT_SIZE=416
