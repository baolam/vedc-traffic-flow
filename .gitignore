# ==========================================
# EdgeFlow AI - Centralized .gitignore
# ==========================================

# ------------------------------------------
# Python & Byte-code
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Node.js & React Dashboard
# ------------------------------------------
node_modules/
**/node_modules/
services/dashboard/node_modules/
services/dashboard/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ------------------------------------------
# Databases & Persistence
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# ------------------------------------------
# SUMO Traffic Simulator & Digital Twin
# ------------------------------------------
*.sumocfg.bak
*.net.xml.bak
*.alt.xml
*.rou.alt.xml
*.traci.log

# ------------------------------------------
# Data, Output & Generated Artifacts
# ------------------------------------------
output/*
!output/.gitkeep
data/processed/*.pkl
data/processed/*.json
data/raw/*.csv

# ------------------------------------------
# Testing & Code Quality
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# ------------------------------------------
# IDEs & System Metadata
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
scratch/
tmp/
