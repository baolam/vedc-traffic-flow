# ==========================================
# EdgeFlow AI - Centralized .gitignore
# ==========================================

# ------------------------------------------
# Python & Byte-code
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Node.js & React Dashboard
# ------------------------------------------
node_modules/
**/node_modules/
services/dashboard/node_modules/
services/dashboard/build/
services/dashboard/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ------------------------------------------
# Databases & Persistence
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# ------------------------------------------
# SUMO Traffic Simulator & Digital Twin Outputs
# ------------------------------------------
*.sumocfg.bak
*.net.xml.bak
*.alt.xml
*.rou.alt.xml
*.traci.log
*.tripinfo.xml
*.summary.xml
*.queue.xml
*.edgedata.xml
*.vehroute.xml
*.vtypeprobe.xml
*.netstate.xml

# ------------------------------------------
# Data, Output & Generated Artifacts
# ------------------------------------------
output/*
!output/.gitkeep
artifacts/*
!artifacts/.gitkeep
!artifacts/benchmark_summary.md
!artifacts/benchmark_comparison_report.json
data/processed/*.pkl
data/processed/*.json
data/raw/*.csv
*.onnx
*.pth
*.pt
*.weights
*.h5

# ------------------------------------------
# Testing & Code Quality
# ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# IDEs & System Metadata
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
scratch/
tmp/
.tmp/
